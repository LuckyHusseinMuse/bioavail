# Person B: agents. Copy to api/.env
GEMINI_API_KEY=
# Any current Gemini model with vision + function calling
GEMINI_MODEL=gemini-2.5-flash
AGENT_MAX_STEPS=8
# 1 = use api/agents/tools_mock.py even if api/agents/tools.py exists
ABSORB_MOCK_TOOLS=0
# 1 = never call Gemini (deterministic fallbacks only; handy for tests and demos with no network)
ABSORB_NO_LLM=0
ALERT_WORDING_LLM=1
