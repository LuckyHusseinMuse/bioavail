# Copy to backend/.env and fill in (copy, don't rename, so this template stays in the repo). Never commit .env.

# Tiger Data (TimescaleDB) connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Auth0 (Applications > APIs). Leave BOTH blank until Auth0 is set up: the API then uses dev tokens instead.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Dev tokens for local work before Auth0 (any long random string). Mint one: python -m api.auth dev|user-1
AUTH_DEV_SECRET=

# Gemini (food recognition). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Web Push (generate with: python -m pipeline.make_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# App
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Europe/London
ALERT_DAILY_LIMIT=3
# Background alert jobs (delivery, shortfall, weekly). true on the server; one API process only.
SCHEDULER_ENABLED=false
