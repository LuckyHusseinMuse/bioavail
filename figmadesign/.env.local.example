# Copy to figmadesign/.env.local (not committed). Everything NEXT_PUBLIC_ is visible in the browser, so no secrets here.

# Auth0 single page application ("Absorb Web"). Leave CLIENT_ID blank to use the local dev login instead
# (needs AUTH_DEV_SECRET in backend/.env; local testing only).
NEXT_PUBLIC_AUTH0_DOMAIN=dev-txuxcswb72blv4fg.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.absorb.app

# Where the FastAPI backend runs (the app proxies /api/* to it)
BACKEND_URL=http://127.0.0.1:8000
