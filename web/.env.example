# ---------- Auth0 (Regular Web Application) ----------
# Leave AUTH0_DOMAIN empty to run in DEMO MODE (no login, a fake demo user).
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# The Auth0 API identifier Person A validates in FastAPI
AUTH0_AUDIENCE=https://api.absorb.app

# ---------- Backend ----------
# Leave empty to use the built-in mock backend in web/mocks (no Python needed).
API_BASE_URL=
# e.g. API_BASE_URL=http://localhost:8000

# ---------- Web Push ----------
# Public half of the VAPID key pair (Person A keeps the private half on the server).
# generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
